{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "student-toolsngsch.vercel.app"
        }
      ],
      "destination": "https://studenttoolsng.com/$1",
      "permanent": true
    },
    {
      "source": "/how-to-calculate-cgpa",
      "destination": "/cgpa-calculator",
      "permanent": true
    },
    {
      "source": "/tutorial/how-to-calculate-cgpa",
      "destination": "/cgpa-calculator",
      "permanent": true
    },
    {
      "source": "/tutorials/physics",
      "destination": "/tutorials",
      "permanent": true
    },
    {
      "source": "/tutorials/study%20tutorials",
      "destination": "/tutorials",
      "permanent": true
    },
    {
      "source": "/tutorials/waec%20grading",
      "destination": "/waec-grade-calculator",
      "permanent": true
    },
    {
      "source": "/tutorials/waec%20tutorials",
      "destination": "/tutorials",
      "permanent": true
    },
    {
      "source": "/tutorials/cgpa%20tutorials",
      "destination": "/cgpa-calculator",
      "permanent": true
    },
    {
      "source": "/tutorials/learn%20the%20simple%20step-by-step%20method%20nigerian%20universities%20use%20to%20calculate%20cgpa%20using%20credit%20units%20and%20grade%20points.",
      "destination": "/cgpa-calculator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://studenttoolsserver.onrender.com/api/sitemap"
    },
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
